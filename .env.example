# ====================================================================
# VARIABLES DE ENTORNO - SISTEMA ODONTOLÓGICO DRA. ADRIANA PARRA
# ====================================================================
# Instrucciones:
# 1. Este archivo lo usas de plantilla. Crea una copia llamada .env
# 2. Registra el proyecto en Supabase con el correo de la odontóloga: Od.adrianaparra@gmail.com
# 3. En Supabase: Ve a Project Settings -> API y copia la Project URL y la anon public key.
# 4. Si dejas estas variables vacías o con valores demo, la app funcionará en "Modo Demostración Local"
#    para que puedas probarla de una sin errores de terminal.
# ====================================================================

# URL del Proyecto de Supabase (creado con el correo de la doctora)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave anónima pública de Supabase
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Datos del Consultorio
VITE_DOCTOR_NAME=Dra. Adriana Parra
VITE_DOCTOR_EMAIL=Od.adrianaparra@gmail.com
VITE_CLINIC_NAME=Centro Odontológico Especializado Dra. Adriana Parra
VITE_CLINIC_PHONE=+58 412-1234567
VITE_DEFAULT_EXCHANGE_RATE=40.00
